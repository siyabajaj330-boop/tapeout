rules_version = '2';

// Tapeout security rules.
// - Every user can read and write only their own data.
// - Documents are schema-checked and size-bounded.
// - Each document accepts at most one write every 2 seconds per user.
// - Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function throttled() {
      return resource == null
        || request.time > resource.data.updatedAt + duration.value(2, 's');
    }

    function validProgress(d) {
      return d.keys().hasOnly(['v', 'solved', 'revealed', 'attempts', 'hints', 'rubric', 'split', 'updatedAt'])
        && d.keys().hasAll(['v', 'solved', 'revealed', 'attempts', 'hints', 'rubric', 'split', 'updatedAt'])
        && d.v == 1
        && d.solved is map && d.solved.size() <= 400
        && d.revealed is map && d.revealed.size() <= 400
        && d.attempts is map && d.attempts.size() <= 400
        && d.hints is map && d.hints.size() <= 400
        && d.rubric is map && d.rubric.size() <= 400
        && d.split is number && d.split >= 30 && d.split <= 70
        && d.updatedAt == request.time;
    }

    function validNote(pid, d) {
      return pid.matches('^(dv|rtl|arch)-[0-9]{2}$')
        && d.keys().hasOnly(['text', 'scratch', 'updatedAt'])
        && d.keys().hasAll(['text', 'scratch', 'updatedAt'])
        && d.text is string && d.text.size() <= 20000
        && d.scratch is string && d.scratch.size() <= 20000
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && validProgress(request.resource.data);
      allow update: if isOwner(uid) && validProgress(request.resource.data) && throttled();
      allow delete: if isOwner(uid);

      match /notes/{pid} {
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid) && validNote(pid, request.resource.data);
        allow update: if isOwner(uid) && validNote(pid, request.resource.data) && throttled();
        allow delete: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
